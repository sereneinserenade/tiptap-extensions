{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": [],
    "paths": {
      "@sereneinserenade/tiptap-extensions": [
        "./src/index.ts"
      ],
      "@sereneinserenade/tiptap-extensions/*": [
        "./src/*/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests"
  ]
}
